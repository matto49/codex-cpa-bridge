{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex CPA Bridge",
  "version": "0.1.0",
  "identifier": "local.codex-cpa-bridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Codex CPA Bridge",
      "width": 1040,
      "height": 720,
      "minWidth": 780,
      "minHeight": 600,
      "resizable": true,
      "fullscreen": false
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
