#!/usr/bin/ruby

require "json"
require "net/http"
require "tempfile"
require "uri"
require "yaml"

CONFIG_PATH = "/Users/bytedance/.config/cliproxyapi/config.yaml"
CATALOG_PATH = "/Users/bytedance/.codex-mac-cpa/model-catalogs/cliproxy-sota.json"
BASE_URL = "http://127.0.0.1:8317/v1/models"

def fetch_json(url, api_key)
  uri = URI(url)
  request = Net::HTTP::Get.new(uri)
  request["Authorization"] = "Bearer #{api_key}"
  response = Net::HTTP.start(uri.host, uri.port, open_timeout: 3, read_timeout: 15) do |http|
    http.request(request)
  end
  raise "CPA returned HTTP #{response.code}" unless response.is_a?(Net::HTTPSuccess)

  JSON.parse(response.body)
end

def display_name(slug)
  return "Traex #{slug.delete_prefix("traex/")}" if slug.start_with?("traex/")

  slug.split("-").map do |part|
    case part.downcase
    when "gpt" then "GPT"
    when "kimi" then "Kimi"
    when "gemini" then "Gemini"
    when "claude" then "Claude"
    when "oss" then "OSS"
    else part.match?(/\A\d/) ? part : part.capitalize
    end
  end.join(" ")
end

def template_slug(slug, owner)
  downcase_slug = slug.downcase
  return "kimi-k3" if owner == "moonshot" || downcase_slug.include?("kimi")
  return "claude-opus-4-6-thinking" if downcase_slug.include?("claude")
  return "traex/GPT-5.6-Sol" if slug.start_with?("traex/") && downcase_slug.include?("gpt")
  return "traex/Gemini-3.1-Pro-Preview" if slug.start_with?("traex/") && downcase_slug.include?("gemini")
  return "traex/DeepSeek-V4-Pro" if slug.start_with?("traex/") && downcase_slug.include?("deepseek")
  return "traex/Seed-2.1-Pro" if slug.start_with?("traex/") && downcase_slug.include?("seed")
  return "traex/openrouter-3o" if slug.start_with?("traex/")
  return "gemini-pro-agent" if downcase_slug.include?("gemini")
  return "gpt-5.5" if owner == "openai" || downcase_slug.start_with?("gpt")

  "gemini-pro-agent"
end

def canonicalize(value)
  case value
  when Hash
    value.keys.sort.each_with_object({}) do |key, result|
      result[key] = canonicalize(value[key])
    end
  when Array
    value.map { |item| canonicalize(item) }
  else
    value
  end
end

def deep_copy(value)
  Marshal.load(Marshal.dump(value))
end

config = YAML.load_file(CONFIG_PATH)
api_key = Array(config["api-keys"]).first
raise "no CPA API key configured" if api_key.nil? || api_key.empty?

models_response = fetch_json(BASE_URL, api_key)
source_models = Array(models_response["data"])
raise "CPA returned an empty model list" if source_models.empty?

rich_response = fetch_json("#{BASE_URL}?client_version=0.154.0", api_key)
rich_models = Array(rich_response["models"])
rich_by_slug = rich_models.to_h { |model| [model["slug"], model] }

existing = File.exist?(CATALOG_PATH) ? JSON.parse(File.read(CATALOG_PATH)) : { "models" => [] }
existing_by_slug = Array(existing["models"]).to_h { |model| [model["slug"], model] }

models = source_models.sort_by { |source| source.fetch("id") }.map do |source|
  slug = source.fetch("id")
  owner = source["owned_by"].to_s
  fallback_slug = template_slug(slug, owner)

  # Existing entries are authoritative so volatile upstream metadata does not
  # rewrite the catalog every minute. Rich metadata is used for new models.
  seed = existing_by_slug[slug]
  seed ||= rich_by_slug[slug]
  seed ||= existing_by_slug[fallback_slug]
  seed ||= rich_by_slug[fallback_slug]
  seed ||= rich_models.first
  raise "no metadata template available for #{slug}" unless seed

  model = deep_copy(seed)
  name = existing_by_slug.dig(slug, "display_name") || model["display_name"]
  name = display_name(slug) if name.nil? || model["slug"] != slug
  visibility = existing_by_slug.dig(slug, "visibility")

  model["slug"] = slug
  model["display_name"] = name
  model["description"] = name
  model["visibility"] = %w[list hide].include?(visibility) ? visibility : "list"
  model["supported_in_api"] = true
  model
end

next_catalog = { "models" => models }

# Model order and JSON object key order are not semantic changes. After the
# first normalized write, identical CPA responses result in no filesystem write.
exit 0 if canonicalize(existing) == canonicalize(next_catalog)

serialized = JSON.pretty_generate(canonicalize(next_catalog)) + "\n"
catalog_dir = File.dirname(CATALOG_PATH)
mode = File.exist?(CATALOG_PATH) ? File.stat(CATALOG_PATH).mode & 0o777 : 0o644

Tempfile.create(["cliproxy-sota", ".json"], catalog_dir) do |temporary|
  temporary.chmod(mode)
  temporary.write(serialized)
  temporary.flush
  temporary.fsync
  File.rename(temporary.path, CATALOG_PATH)
end

puts "Synced #{models.length} CPA models; app-server restart deferred until next reconnect"
